using System;
					
public delegate void ProcessCompletedHandler(object Sender, EventArgs e);

public class Program
{
	public static void Main()
	{
		Console.WriteLine("Hello World");
		Process p = new Process();
		p.Completed += p.OnProcessingCompleted;
		p.Run();
		
	}
}

class Process
{
	public event ProcessCompletedHandler Completed;
	
	public void Run()
	{
		Console.WriteLine("Processing......");
		
		Completed(this, EventArgs.Empty);
	}
	
	public void OnProcessingCompleted(object Sender, EventArgs e)
	{
		Console.WriteLine("Processing Completed");
	}
}
